// SaaS Galpao — Prisma Schema
// Multi-tenant: cada empresa (Tenant) tem seus dados isolados via tenantId.
// Toda query do app DEVE incluir tenantId — isso é garantido pelo helper em src/lib/tenant.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// AUTH & TENANCY
// =========================================================

enum Role {
  ADMIN
  GESTOR
  FINANCEIRO
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  galpoes      Galpao[]
  contratos    Contrato[]
  receitas     Receita[]
  despesas     Despesa[]
  alertas      Alerta[]
  auditLogs    AuditLog[]
  documentos   DocumentoGalpao[]
  manutencoes  Manutencao[]
  vistorias    Vistoria[]
  subscription Subscription?

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(GESTOR)
  active        Boolean   @default(true)
  // Convites: token gerado quando o admin convida; o usuario aceita
  // definindo senha. Apos aceitar, esses campos voltam a NULL.
  inviteToken   String?   @unique
  inviteExpires DateTime?
  invitedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([inviteToken])
}

// Auth.js sessions (caso use JWT puro, podemos remover; mantido p/ flexibilidade)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

// =========================================================
// CORE DOMAIN
// =========================================================

enum TipoGalpao {
  LOGISTICO
  INDUSTRIAL
  ARMAZENAMENTO
}

enum StatusGalpao {
  DISPONIVEL
  OCUPADO
  EM_NEGOCIACAO
  MANUTENCAO
}

model Galpao {
  id               String       @id @default(cuid())
  tenantId         String
  nome             String
  endereco         String
  cidade           String
  estado           String       @db.Char(2)
  cep              String
  metragemTotal    Decimal      @db.Decimal(12, 2)
  metragemDisponivel Decimal    @db.Decimal(12, 2)
  tipo             TipoGalpao
  valorPorM2       Decimal      @db.Decimal(12, 2)
  status           StatusGalpao @default(DISPONIVEL)
  observacoes      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos   Contrato[]
  documentos  DocumentoGalpao[]
  manutencoes Manutencao[]

  @@index([tenantId, status])
  @@index([tenantId, tipo])
}

enum StatusContrato {
  ATIVO
  ENCERRADO
  CANCELADO
  PENDENTE
}

model Contrato {
  id                 String         @id @default(cuid())
  tenantId           String
  galpaoId           String
  numero             String
  empresaLocataria   String
  cnpjLocataria      String
  emailLocataria     String?
  telefoneLocataria  String?
  dataInicio         DateTime
  dataFim            DateTime
  valorMensal        Decimal        @db.Decimal(12, 2)
  diaVencimento      Int            @default(5)
  reajusteAnual      Decimal?       @db.Decimal(5, 2) // % de reajuste
  indiceReajuste     String?        // IGPM, IPCA, etc
  status             StatusContrato @default(ATIVO)
  documentoUrl       String?        // URL no Supabase Storage
  observacoes        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  galpao      Galpao       @relation(fields: [galpaoId], references: [id], onDelete: Restrict)
  receitas    Receita[]
  manutencoes Manutencao[]
  vistorias   Vistoria[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, galpaoId])
  @@index([tenantId, dataFim])
}

// =========================================================
// FINANCEIRO
// =========================================================

enum StatusPagamento {
  PENDENTE
  PAGO
  PARCIAL
  ATRASADO
  CANCELADO
}

enum CategoriaDespesa {
  MANUTENCAO
  IMPOSTOS
  SEGURO
  ENERGIA
  AGUA
  PESSOAL
  OUTROS
}

model Receita {
  id           String          @id @default(cuid())
  tenantId     String
  contratoId   String
  competencia  DateTime        // mês/ano de referência (dia 1)
  vencimento   DateTime
  valor        Decimal         @db.Decimal(12, 2)
  valorPago    Decimal?        @db.Decimal(12, 2)
  dataPagamento DateTime?
  status       StatusPagamento @default(PENDENTE)
  observacoes  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, vencimento])
  @@index([tenantId, competencia])
}

model Despesa {
  id          String           @id @default(cuid())
  tenantId    String
  galpaoId    String?
  descricao   String
  categoria   CategoriaDespesa
  competencia DateTime
  vencimento  DateTime
  valor       Decimal          @db.Decimal(12, 2)
  pago        Boolean          @default(false)
  dataPagamento DateTime?
  observacoes String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, categoria])
  @@index([tenantId, vencimento])
}

// =========================================================
// AUTOMAÇÃO & AUDITORIA
// =========================================================

enum TipoAlerta {
  CONTRATO_VENCENDO
  PAGAMENTO_ATRASADO
  GALPAO_OCIOSO
  REAJUSTE_PENDENTE
  DOCUMENTO_VENCENDO
  IPTU_PENDENTE
  INSIGHT_AI
}

enum SeveridadeAlerta {
  INFO
  WARNING
  CRITICAL
}

model Alerta {
  id         String           @id @default(cuid())
  tenantId   String
  tipo       TipoAlerta
  severidade SeveridadeAlerta @default(INFO)
  titulo     String
  mensagem   String
  refType    String? // "contrato", "galpao", "receita"
  refId      String?
  lido       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, lido])
  @@index([tenantId, tipo])
}

// =========================================================
// DOCUMENTOS COM VIGENCIA POR GALPAO
// =========================================================
// AVCB (bombeiros, ~24m), Licenca Ambiental, Alvara, IPTU,
// laudos tecnicos, analises (potabilidade etc) — qualquer doc
// que precisa renovar e cuja perda de validade gera risco.

enum TipoDocumentoGalpao {
  AVCB
  LICENCA_AMBIENTAL
  ALVARA_FUNCIONAMENTO
  IPTU
  LAUDO_TECNICO
  ANALISE_POTABILIDADE
  PGRS
  OUTROS
}

enum StatusDocumento {
  VIGENTE
  PROXIMO_VENCIMENTO
  VENCIDO
  EM_RENOVACAO
  NAO_APLICA
}

enum ResponsavelPagamento {
  LOCADOR
  LOCATARIA
  COMPARTILHADO
}

model DocumentoGalpao {
  id                       String                @id @default(cuid())
  tenantId                 String
  galpaoId                 String
  tipo                     TipoDocumentoGalpao
  nome                     String                // descricao livre: "AVCB 2024-2026"
  numero                   String?               // protocolo / numero do doc
  emissor                  String?               // orgao emissor
  dataEmissao              DateTime?
  dataValidade             DateTime
  frequenciaRenovacaoMeses Int?                  // 24 (AVCB), 3 (trimestral)...
  alertarDiasAntes         Int                   @default(60)
  status                   StatusDocumento       @default(VIGENTE)
  // Para IPTU principalmente — quem paga
  responsavelPagamento     ResponsavelPagamento?
  // Anexos (URL no Supabase Storage quando E4 entrar)
  documentoUrl             String?
  observacoes              String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  galpao Galpao @relation(fields: [galpaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataValidade])
  @@index([tenantId, galpaoId])
  @@index([tenantId, tipo])
  @@index([tenantId, status])
}

// =========================================================
// MANUTENCOES (preventiva / corretiva / emergencial)
// =========================================================

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
  EMERGENCIAL
}

enum CategoriaManutencao {
  ELETRICA
  HIDRAULICA
  ESTRUTURAL
  COBERTURA
  PINTURA
  PORTAS_PORTOES
  PISO
  CLIMATIZACAO
  SEGURANCA
  LIMPEZA
  OUTROS
}

enum StatusManutencao {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Manutencao {
  id               String                @id @default(cuid())
  tenantId         String
  galpaoId         String
  contratoId       String?
  tipo             TipoManutencao
  categoria        CategoriaManutencao
  descricao        String
  prestador        String
  prestadorContato String?
  prestadorCnpj    String?
  dataInicio       DateTime
  dataFim          DateTime?
  valor            Decimal               @db.Decimal(12, 2)
  pagoPor          ResponsavelPagamento?
  status           StatusManutencao      @default(AGENDADA)
  // Fotos: text[] no Postgres. Cliente cola URLs por enquanto.
  // Quando E4 (Supabase Storage) entrar, vira upload nativo sem
  // mudar o shape destes campos.
  fotosAntes       String[]              @default([])
  fotosDepois      String[]              @default([])
  notaFiscalUrl    String?
  observacoes      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  galpao   Galpao    @relation(fields: [galpaoId], references: [id], onDelete: Cascade)
  contrato Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  @@index([tenantId, galpaoId])
  @@index([tenantId, contratoId])
  @@index([tenantId, status])
  @@index([tenantId, dataInicio])
  @@index([tenantId, categoria])
}

// =========================================================
// VISTORIAS (Laudo Inicial e Final do contrato)
// =========================================================

enum TipoVistoria {
  INICIAL
  FINAL
}

enum StatusVistoria {
  RASCUNHO
  FINALIZADA
}

enum AreaVistoria {
  ESTRUTURA
  COBERTURA
  PISO
  PAREDES
  PORTAS_PORTOES
  ELETRICA
  HIDRAULICA
  ILUMINACAO
  CLIMATIZACAO
  EXTERNO_PATIO
  SEGURANCA
  OUTROS
}

enum CondicaoItem {
  BOM
  REGULAR
  RUIM
  CRITICO
  NAO_APLICA
}

model Vistoria {
  id                   String         @id @default(cuid())
  tenantId             String
  contratoId           String
  tipo                 TipoVistoria
  dataVistoria         DateTime
  responsavelInterno   String?
  responsavelLocataria String?
  cpfLocataria         String?
  observacoesGerais    String?
  fotosGerais          String[]       @default([])
  status               StatusVistoria @default(RASCUNHO)
  documentoUrl         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  itens    ItemVistoria[]

  @@unique([contratoId, tipo])
  @@index([tenantId])
  @@index([tenantId, contratoId])
  @@index([tenantId, status])
}

model ItemVistoria {
  id         String       @id @default(cuid())
  vistoriaId String
  area       AreaVistoria
  descricao  String?
  condicao   CondicaoItem
  observacao String?
  fotos      String[]     @default([])
  ordem      Int          @default(0)

  vistoria Vistoria @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)

  @@index([vistoriaId])
}

// =========================================================
// SUBSCRIPTION (assinatura/plano por tenant)
// =========================================================

enum Plan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  plan             Plan               @default(STARTER)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}
