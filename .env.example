# ============================================
# SaaS Galpao — Environment Variables Example
# ============================================
# Copy to .env (local) ou configure na Vercel.
# NUNCA comite .env real — apenas .env.example.

# --- Database (Neon / Supabase / local Postgres) ---
# Use o pooler URL (porta 6543 no Supabase, "?pgbouncer=true" no Neon) em prod.
DATABASE_URL="postgresql://user:password@host:5432/saas_galpao?schema=public"
# DIRECT_URL é usado pelo prisma migrate (sem pooler).
DIRECT_URL="postgresql://user:password@host:5432/saas_galpao?schema=public"

# --- Auth.js (NextAuth v5) ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-uma-string-aleatoria-de-32-bytes"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# --- Anthropic (agentes de IA do produto) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Storage (Supabase) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="contratos"

# --- Cron (Vercel) ---
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A Vercel envia automaticamente Authorization: Bearer <CRON_SECRET> nos crons.
CRON_SECRET="trocar-por-string-aleatoria-de-32-bytes-hex"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
